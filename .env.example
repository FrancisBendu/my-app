# Copy this file to .env and fill in the values from Supabase:
# Dashboard -> green "Connect" button (or Project Settings -> API Keys).
# Use the anon / publishable key. NEVER put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
